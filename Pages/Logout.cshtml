@page
@model SecurityCapstone.Pages.LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h2 class="mb-4">You have been logged out</h2>
            <p>Thank you for using SecurityCapstone.</p>
            <a asp-page="/Login" class="btn btn-primary">Login Again</a>
            <a asp-page="/Index" class="btn btn-secondary">Go to Home</a>
        </div>
    </div>
</div>
